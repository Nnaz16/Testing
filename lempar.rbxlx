		<Item class="StarterPlayerScripts" referent="RBX4">
			<Properties>
				<string name="Name">StarterPlayerScripts</string>
			</Properties>
			<Item class="LocalScript" referent="RBX5">
				<Properties>
					<string name="Name">LemparAnimasi</string>
					<ProtectedString name="Source"><![CDATA[
-- Animasi melempar (procedural, tanpa upload animasi)
local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local Debris = game:GetService("Debris")

local player = Players.LocalPlayer

-- PENGATURAN
local KEKUATAN = 80      -- kecepatan lempar
local TINGGI = 25        -- dorongan ke atas
local COOLDOWN = 1       -- detik

-- GUI tombol
local gui = Instance.new("ScreenGui")
gui.Name = "LemparGui"
gui.ResetOnSpawn = false
gui.Parent = player:WaitForChild("PlayerGui")

local btn = Instance.new("TextButton")
btn.Size = UDim2.fromOffset(110, 50)
btn.Position = UDim2.new(1, -130, 1, -140)
btn.Text = "Lempar"
btn.Font = Enum.Font.GothamBold
btn.TextSize = 20
btn.TextColor3 = Color3.new(1, 1, 1)
btn.BackgroundColor3 = Color3.fromRGB(255, 140, 0)
btn.Parent = gui
Instance.new("UICorner", btn)

local function getArm(char)
	-- R15
	local upper = char:FindFirstChild("RightUpperArm")
	if upper then
		return upper:FindFirstChild("RightShoulder"), upper
	end
	-- R6
	local torso = char:FindFirstChild("Torso")
	if torso then
		return torso:FindFirstChild("Right Shoulder"), char:FindFirstChild("Right Arm")
	end
end

local function rotasi(shoulder, c0, derajat)
	if shoulder.Part0 and shoulder.Part0.Name == "Torso" then
		return c0 * CFrame.Angles(0, 0, math.rad(derajat)) -- R6
	end
	return c0 * CFrame.Angles(math.rad(derajat), 0, 0) -- R15
end

local sibuk = false

local function lempar()
	if sibuk then return end
	local char = player.Character
	if not char then return end
	local hrp = char:FindFirstChild("HumanoidRootPart")
	local shoulder, arm = getArm(char)
	if not (hrp and shoulder and arm) then return end

	sibuk = true
	local c0Asli = shoulder.C0

	-- 1) Tarik tangan ke belakang
	local t1 = TweenService:Create(shoulder, TweenInfo.new(0.25, Enum.EasingStyle.Quad), {C0 = rotasi(shoulder, c0Asli, -100)})
	t1:Play()
	t1.Completed:Wait()

	-- 2) Ayun ke depan
	local t2 = TweenService:Create(shoulder, TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {C0 = rotasi(shoulder, c0Asli, 150)})
	t2:Play()
	task.wait(0.07)

	-- Lepas bola di tengah ayunan
	local bola = Instance.new("Part")
	bola.Shape = Enum.PartType.Ball
	bola.Size = Vector3.new(1.5, 1.5, 1.5)
	bola.Material = Enum.Material.SmoothPlastic
	bola.Color = Color3.fromRGB(255, 80, 80)
	bola.CFrame = hrp.CFrame * CFrame.new(1.5, 1, -2.5)
	bola.Parent = workspace
	bola.AssemblyLinearVelocity = hrp.CFrame.LookVector * KEKUATAN + Vector3.new(0, TINGGI, 0)
	Debris:AddItem(bola, 6)

	t2.Completed:Wait()

	-- 3) Kembali ke posisi awal
	local t3 = TweenService:Create(shoulder, TweenInfo.new(0.3, Enum.EasingStyle.Quad), {C0 = c0Asli})
	t3:Play()
	t3.Completed:Wait()

	task.wait(COOLDOWN)
	sibuk = false
end

btn.Activated:Connect(lempar)

player.CharacterAdded:Connect(function()
	sibuk = false
end)
]]></ProtectedString>
				</Properties>
			</Item>
		</Item>
	</Item>
	<Item class="StarterPack" referent="RBX6">
		<Properties>
			<string name="Name">StarterPack</string>
