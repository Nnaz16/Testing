  <Item class="ReplicatedStorage">
    <Properties>
      <string name="Name">ReplicatedStorage</string>
    </Properties>
    <Item class="Folder">
      <Properties>
        <string name="Name">FishingRemotes</string>
      </Properties>
      <Item class="RemoteEvent">
        <Properties>
          <string name="Name">Cast</string>
