r3 name="Color"><R>0.16</R><G>0.18</G><B>0.19</B></Color3><bool name="Anchored">true</bool><token name="Material">1</token><float name="Transparency">0</float><bool name="CanCollide">true</bool></Properties></Item><Item class="Part"><Properties><string name="Name">SupplyTable</string><Vector3 name="Size"><X>10</X><Y>2</Y><Z>5</Z></Vector3><CoordinateFrame name="CFrame"><X>-24</X><Y>2</Y><Z>18</Z><R00>1</R00><R01>0</R01><R02>0</R02><R10>0</R10><R11>1</R11><R12>0</R12><R20>0</R20><R21>0</R21><R22>1</R22></CoordinateFrame><Color3 name="Color"><R>0.25</R><G>0.27</G><B>0.28</B></Color3><bool name="Anchored">true</bool><token name="Material">1</token><float name="Transparency">0</float><bool name="CanCollide">true</bool></Properties></Item><Item class="Part"><Properties><string name="Name">SupplyBox</string><Vector3 name="Size"><X>4</X><Y>3</Y><Z>4</Z></Vector3><CoordinateFrame name="CFrame"><X>-24</X><Y>4</Y><Z>18</Z><R00>1</R00><R01>0</R01><R02>0</R02><R10>0</R10><R11>1</R11><R12>0</R12><R20>0</R20><R21>0</R21><R22>1</R22></CoordinateFrame><Color3 name="Color"><R>0.35</R><G>0.2</G><B>0.1</B></Color3><bool name="Anchored">true</bool><token name="Material">1</token><float name="Transparency">0</float><bool name="CanCollide">true</bool></Properties></Item><Item class="Part"><Properties><string name="Name">SupplyTable</string><Vector3 name="Size"><X>10</X><Y>2</Y><Z>5</Z></Vector3><CoordinateFrame name="CFrame"><X>24</X><Y>2</Y><Z>18</Z><R00>1</R00><R01>0</R01><R02>0</R02><R10>0</R10><R11>1</R11><R12>0</R12><R20>0</R20><R21>0</R21><R22>1</R22></CoordinateFrame><Color3 name="Color"><R>0.25</R><G>0.27</G><B>0.28</B></Color3><bool name="Anchored">true</bool><token name="Material">1</token><float name="Transparency">0</float><bool name="CanCollide">true</bool></Properties></Item><Item class="Part"><Properties><string name="Name">SupplyBox</string><Vector3 name="Size"><X>4</X><Y>3</Y><Z>4</Z></Vector3><CoordinateFrame name="CFrame"><X>24</X><Y>4</Y><Z>18</Z><R00>1</R00><R01>0</R01><R02>0</R02><R10>0</R10><R11>1</R11><R12>0</R12><R20>0</R20><R21>0</R21><R22>1</R22></CoordinateFrame><Color3 name="Color"><R>0.35</R><G>0.2</G><B>0.1</B></Color3><bool name="Anchored">true</bool><token name="Material">1</token><float name="Transparency">0</float><bool name="CanCollide">true</bool></Properties></Item><Item class="Part"><Properties><string name="Name">LobbyAccent</string><Vector3 name="Size"><X>36</X><Y>1</Y><Z>36</Z></Vector3><CoordinateFrame name="CFrame"><X>0</X><Y>3</Y><Z>-90</Z><R00>1</R00><R01>0</R01><R02>0</R02><R10>0</R10><R11>1</R11><R12>0</R12><R20>0</R20><R21>0</R21><R22>1</R22></CoordinateFrame><Color3 name="Color"><R>0.08</R><G>0.22</G><B>0.25</B></Color3><bool name="Anchored">true</bool><token name="Material">6</token><float name="Transparency">0</float><bool name="CanCollide">true</bool></Properties></Item><Item class="Part"><Properties><string name="Name">LobbyAccent</string><Vector3 name="Size"><X>28</X><Y>1</Y><Z>28</Z></Vector3><CoordinateFrame name="CFrame"><X>0</X><Y>3</Y><Z>-90</Z><R00>1</R00><R01>0</R01><R02>0</R02><R10>0</R10><R11>1</R11><R12>0</R12><R20>0</R20><R21>0</R21><R22>1</R22></CoordinateFrame><Color3 name="Color"><R>0.08</R><G>0.22</G><B>0.25</B></Color3><bool name="Anchored">true</bool><token name="Material">6</token><float name="Transparency">0</float><bool name="CanCollide">true</bool></Properties></Item></Item>
  <Item class="ServerScriptService">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Script">
      <Properties>
        <string name="Name">NightGameServer</string>
        <ProtectedString name="Source">local Players=game:GetService("Players")
local RunService=game:GetService("RunService")
local Workspace=game:GetService("Workspace")
local keysNeeded=5
local collected={}
local safe=Workspace:WaitForChild("SafeZone")
local escape=Workspace:WaitForChild("EscapePlatform")
local monsterSpawn=Workspace:WaitForChild("MonsterSpawn")
local monster=Instance.new("Model"); monster.Name="NightStalker"; monster.Parent=Workspace
local body=Instance.new("Part"); body.Name="HumanoidRootPart"; body.Size=Vector3.new(5,8,5); body.Anchored=true; body.CanCollide=false; body.Material=Enum.Material.Slate; body.Color=Color3.fromRGB(15,15,20); body.Parent=monster
local face=Instance.new("Part"); face.Name="Eyes"; face.Size=Vector3.new(2,1,0.3); face.Anchored=true; face.CanCollide=false; face.Material=Enum.Material.Neon; face.Color=Color3.fromRGB(255,40,40); face.Parent=monster
monster.PrimaryPart=body
local spawnPos=monsterSpawn.Position+Vector3.new(0,5,0); body.Position=spawnPos; face.Position=spawnPos+Vector3.new(0,2,-2.5)
local activeTarget=nil
local safePlayers={}
local function countKeys(plr) return collected[plr] or 0 end
local function updateStats(plr) local ls=plr:FindFirstChild("leaderstats"); if ls then local v=ls:FindFirstChild("Keys"); if v then v.Value=countKeys(plr) end end end
Players.PlayerAdded:Connect(function(plr) collected[plr]=0; local ls=Instance.new("Folder",plr); ls.Name="leaderstats"; local v=Instance.new("IntValue",ls); v.Name="Keys"; v.Value=0; local wins=Instance.new("IntValue",ls); wins.Name="Escapes"; wins.Value=0 end)
Players.PlayerRemoving:Connect(function(plr) collected[plr]=nil; safePlayers[plr]=nil end)
for _,key in ipairs(Workspace:GetChildren()) do if key.Name:match("KeyPickup") then local prompt=key:FindFirstChildOfClass("ProximityPrompt"); if prompt then prompt.Triggered:Connect(function(plr) if key:GetAttribute("Taken") then return end; key:SetAttribute("Taken",true); collected[plr]=(collected[plr] or 0)+1; updateStats(plr); key.Transparency=1; prompt.Enabled=false; key.CanCollide=false end) end end end
local function inside(part, pos) local localPos=part.CFrame:PointToObjectSpace(pos); local half=part.Size/2; return math.abs(localPos.X)&lt;=half.X and math.abs(localPos.Y)&lt;=half.Y+5 and math.abs(localPos.Z)&lt;=half.Z end
safe.Touched:Connect(function(hit) local plr=Players:GetPlayerFromCharacter(hit.Parent); if plr then safePlayers[plr]=true end end)
safe.TouchEnded:Connect(function(hit) local plr=Players:GetPlayerFromCharacter(hit.Parent); if plr then safePlayers[plr]=nil end end)
escape.Touched:Connect(function(hit) local plr=Players:GetPlayerFromCharacter(hit.Parent); if plr and countKeys(plr)&gt;=keysNeeded then local ls=plr:FindFirstChild("leaderstats"); if ls and ls:FindFirstChild("Escapes") then ls.Escapes.Value+=1 end; collected[plr]=0; updateStats(plr); if plr.Character then plr.Character:PivotTo(Workspace.LobbySpawn.CFrame+Vector3.new(0,5,0)) end end end)
local chaseSpeed=22; local detection=85; local lastHit={}
while task.wait(.12) do local nearest,dist=nil,detection; for _,plr in ipairs(Players:GetPlayers()) do local char=plr.Character; local hrp=char and char:FindFirstChild("HumanoidRootPart"); local hum=char and char:FindFirstChildOfClass("Humanoid"); if hrp and hum and hum.Health&gt;0 and not safePlayers[plr] then local d=(hrp.Position-body.Position).Magnitude; if d&lt;dist then nearest=hrp; dist=d end end end
if nearest then local pos=body.Position; local target=nearest.Position; local flat=Vector3.new(target.X,pos.Y,target.Z); local delta=flat-pos; if delta.Magnitude&gt;2 then body.Position=pos+delta.Unit*math.min(chaseSpeed*.12,delta.Magnitude); face.Position=body.Position+Vector3.new(0,2,-2.5); body.CFrame=CFrame.lookAt(body.Position,flat); face.CFrame=body.CFrame*CFrame.new(0,2,-2.5) end; local plr=Players:GetPlayerFromCharacter(nearest.Parent); if plr and dist&lt;5 and not lastHit[plr] then lastHit[plr]=true; local hum=nearest.Parent:FindFirstChildOfClass("Humanoid"); if hum then hum.Health=0 end; task.delay(2,function() lastHit[plr]=nil end) end
else body.Position=body.Position+(spawnPos-body.Position).Unit*math.min(1.5,(spawnPos-body.Position).Magnitude); face.Position=body.Position+Vector3.new(0,2,-2.5) end end
</ProtectedString>
      </Properties>
    </Item>
  </Item>
  <Item class="StarterPlayer">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="LocalScript">
        <Properties>
          <string name="Name">EscapeNightUI</string>
          <ProtectedString name="Source">local Players=game:GetService("Players")
local TweenService=game:GetService("TweenService")
local p=Players.LocalPlayer
local gui=Instance.new("ScreenGui"); gui.Name="EscapeNightUI"; gui.ResetOnSpawn=false; gui.IgnoreGuiInset=false; gui.Parent=p:WaitForChild("PlayerGui")
local panel=Instance.new("Frame",gui); panel.Size=UDim2.new(0,340,0,116); panel.Position=UDim2.new(0,16,0,16); panel.BackgroundColor3=Color3.fromRGB(13,20,25); panel.BackgroundTransparency=.08; panel.BorderSizePixel=0
Instance.new("UICorner",panel).CornerRadius=UDim.new(0,14); local stroke=Instance.new("UIStroke",panel); stroke.Color=Color3.fromRGB(60,220,180); stroke.Transparency=.35; stroke.Thickness=1.5
local title=Instance.new("TextLabel",panel); title.Size=UDim2.new(1,-24,0,34); title.Position=UDim2.new(0,12,0,8); title.BackgroundTransparency=1; title.Text="◈  ESCAPE THE NIGHT"; title.Font=Enum.Font.GothamBold; title.TextSize=18; title.TextColor3=Color3.fromRGB(100,245,205); title.TextXAlignment=Enum.TextXAlignment.Left
local sub=Instance.new("TextLabel",panel); sub.Size=UDim2.new(1,-24,0,52); sub.Position=UDim2.new(0,12,0,48); sub.BackgroundTransparency=1; sub.Text="OBJECTIVE  •  Find 5 keys\nAvoid the Stalker and escape."; sub.Font=Enum.Font.GothamMedium; sub.TextSize=15; sub.TextColor3=Color3.fromRGB(220,230,235); sub.TextXAlignment=Enum.TextXAlignment.Left; sub.TextYAlignment=Enum.TextYAlignment.Top
local status=Instance.new("TextLabel",gui); status.Size=UDim2.new(0,320,0,42); status.Position=UDim2.new(.5,-160,1,-70); status.BackgroundColor3=Color3.fromRGB(12,18,24); status.BackgroundTransparency=.08; status.Text="Find the keys • Stay out of sight"; status.TextColor3=Color3.fromRGB(240,245,245); status.Font=Enum.Font.GothamBold; status.TextSize=16; status.Parent=gui; Instance.new("UICorner",status).CornerRadius=UDim.new(0,10); local st=Instance.new("UIStroke",status); st.Color=Color3.fromRGB(60,220,180); st.Transparency=.5
local ls=p:WaitForChild("leaderstats",10); if ls then local keys=ls:WaitForChild("Keys",10); if keys then keys:GetPropertyChangedSignal("Value"):Connect(function() status.Text="Keys collected: "..keys.Value.." / 5"; TweenService:Create(status,TweenInfo.new(.2),{Size=UDim2.new(0,330,0,46)}):Play(); task.delay(.2,function() TweenService:Create(status,TweenInfo.new(.2),{Size=UDim2.new(0,320,0,42)}):Play() end) end) end end
local function fit() panel.Size=UDim2.new(0,math.min(340,gui.AbsoluteSize.X-24),0,116) end; gui:GetPropertyChangedSignal("AbsoluteSize"):Connect(fit)
</ProtectedString>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="Folder">
    <Properties>
      <string name="Name">Lighting</string>
    </Properties>
  </Item>
</roblox>