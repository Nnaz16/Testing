</Properties>
<Item class="LocalScript" referent="RBX14"><Properties>
<string name="Name">MancingClient</string>
<ProtectedString name="Source"><![CDATA[local Players = game:GetService("Players")
local RS = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local player = Players.LocalPlayer
local Data = require(RS:WaitForChild("GameData"))
local Remotes = RS:WaitForChild("Remotes")
local ls = player:WaitForChild("leaderstats")
local coins = ls:WaitForChild("Koin")
local fishCount = ls:WaitForChild("Ikan")
local rodLevel = ls:WaitForChild("Pancing")

local function make(class, props, parent)
	local obj = Instance.new(class)
	for k, v in pairs(props) do
		obj[k] = v
	end
	obj.Parent = parent
	return obj
end

local function corner(obj, r)
	make("UICorner", {CornerRadius = UDim.new(0, r or 10)}, obj)
end

local gui = make("ScreenGui", {Name = "MancingCuan", ResetOnSpawn = false}, player:WaitForChild("PlayerGui"))

-- Statistik atas
local stats = make("Frame", {
	Size = UDim2.new(0, 320, 0, 40),
	Position = UDim2.new(0.5, -160, 0, 10),
	BackgroundColor3 = Color3.fromRGB(20, 24, 34),
	BackgroundTransparency = 0.15,
	BorderSizePixel = 0,
}, gui)
corner(stats, 12)
local statsLabel = make("TextLabel", {
	Size = UDim2.new(1, 0, 1, 0),
	BackgroundTransparency = 1,
	TextColor3 = Color3.new(1, 1, 1),
	Font = Enum.Font.GothamBold,
	TextSize = 14,
	Text = "",
}, stats)

-- Notifikasi
local toast = make("TextLabel", {
	Size = UDim2.new(0, 320, 0, 36),
	Position = UDim2.new(0.5, -160, 0, 58),
	BackgroundColor3 = Color3.fromRGB(20, 24, 34),
	BackgroundTransparency = 1,
	TextTransparency = 1,
	Font = Enum.Font.GothamBold,
	TextSize = 15,
	Text = "",
	TextColor3 = Color3.new(1, 1, 1),
}, gui)
corner(toast, 10)
local toastToken = 0
local function showToast(text, color)
	toastToken += 1
	local my = toastToken
	toast.Text = text
	toast.TextColor3 = color or Color3.new(1, 1, 1)
	toast.BackgroundTransparency = 0.15
	toast.TextTransparency = 0
	task.delay(2.5, function()
		if my == toastToken then
			TweenService:Create(toast, TweenInfo.new(0.4), {BackgroundTransparency = 1, TextTransparency = 1}):Play()
		end
	end)
end

-- Tombol bawah
local castBtn = make("TextButton", {
	Size = UDim2.new(0, 190, 0, 56),
	Position = UDim2.new(0.5, -95, 1, -90),
	BackgroundColor3 = Color3.fromRGB(40, 150, 255),
	Font = Enum.Font.GothamBold,
	TextSize = 18,
	TextColor3 = Color3.new(1, 1, 1),
	Text = "Lempar Pancing",
	BorderSizePixel = 0,
}, gui)
corner(castBtn, 14)

local sellBtn = make("TextButton", {
	Size = UDim2.new(0, 110, 0, 44),
	Position = UDim2.new(0.5, -215, 1, -84),
	BackgroundColor3 = Color3.fromRGB(60, 180, 90),
	Font = Enum.Font.GothamBold,
	TextSize = 15,
	TextColor3 = Color3.new(1, 1, 1),
	Text = "Jual Ikan",
	BorderSizePixel = 0,
}, gui)
corner(sellBtn, 12)

local shopBtn = make("TextButton", {
	Size = UDim2.new(0, 110, 0, 44),
	Position = UDim2.new(0.5, 105, 1, -84),
	BackgroundColor3 = Color3.fromRGB(230, 160, 40),
	Font = Enum.Font.GothamBold,
	TextSize = 15,
	TextColor3 = Color3.new(1, 1, 1),
	Text = "Toko",
	BorderSizePixel = 0,
}, gui)
corner(shopBtn, 12)

-- Toko
local shop = make("Frame", {
	Size = UDim2.new(0, 300, 0, 290),
	Position = UDim2.new(0.5, -150, 0.5, -145),
	BackgroundColor3 = Color3.fromRGB(20, 24, 34),
	BorderSizePixel = 0,
	Visible = false,
}, gui)
corner(shop, 14)
make("TextLabel", {
	Size = UDim2.new(1, -50, 0, 40),
	Position = UDim2.new(0, 14, 0, 0),
	BackgroundTransparency = 1,
	Text = "Toko Pancing",
	TextXAlignment = Enum.TextXAlignment.Left,
	TextColor3 = Color3.new(1, 1, 1),
	Font = Enum.Font.GothamBold,
	TextSize = 18,
}, shop)
local closeBtn = make("TextButton", {
	Size = UDim2.new(0, 30, 0, 30),
	Position = UDim2.new(1, -38, 0, 6),
	BackgroundColor3 = Color3.fromRGB(190, 60, 60),
	Text = "X",
	TextColor3 = Color3.new(1, 1, 1),
	Font = Enum.Font.GothamBold,
	TextSize = 14,
	BorderSizePixel = 0,
}, shop)
corner(closeBtn, 8)

local rows = {}
for i, rod in ipairs(Data.RODS) do
	local row = make("Frame", {
		Size = UDim2.new(1, -24, 0, 56),
		Position = UDim2.new(0, 12, 0, 46 + (i - 1) * 62),
		BackgroundColor3 = Color3.fromRGB(34, 40, 56),
		BorderSizePixel = 0,
	}, shop)
	corner(row, 10)
	make("TextLabel", {
		Size = UDim2.new(0.55, 0, 1, 0),
		Position = UDim2.new(0, 10, 0, 0),
		BackgroundTransparency = 1,
		Text = rod.name .. "\nLuck x" .. rod.luck,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = Color3.new(1, 1, 1),
		Font = Enum.Font.Gotham,
		TextSize = 13,
	}, row)
	local btn = make("TextButton", {
		Size = UDim2.new(0, 96, 0, 38),
		Position = UDim2.new(1, -104, 0.5, -19),
		BackgroundColor3 = Color3.fromRGB(230, 160, 40),
		TextColor3 = Color3.new(1, 1, 1),
		Font = Enum.Font.GothamBold,
		TextSize = 13,
		Text = "",
		BorderSizePixel = 0,
	}, row)
	corner(btn, 8)
	btn.MouseButton1Click:Connect(function()
		Remotes.BuyRod:FireServer(i)
	end)
	rows[i] = btn
end

local function refreshShop()
	for i, rod in ipairs(Data.RODS) do
		local btn = rows[i]
		if i < rodLevel.Value then
			btn.Text = "Dimiliki"
			btn.BackgroundColor3 = Color3.fromRGB(90, 90, 100)
		elseif i == rodLevel.Value then
			btn.Text = "Dipakai"
			btn.BackgroundColor3 = Color3.fromRGB(60, 180, 90)
		else
			btn.Text = "Beli " .. rod.price
			btn.BackgroundColor3 = Color3.fromRGB(230, 160, 40)
		end
	end
end

local function refreshStats()
	statsLabel.Text = "Koin: " .. coins.Value .. "   Ikan: " .. fishCount.Value .. "   " .. Data.RODS[rodLevel.Value].name
	refreshShop()
end

coins.Changed:Connect(refreshStats)
fishCount.Changed:Connect(refreshStats)
rodLevel.Changed:Connect(refreshStats)
refreshStats()

-- Aksi tombol
local casting = false

castBtn.MouseButton1Click:Connect(function()
	if casting then return end
	Remotes.Cast:FireServer()
end)
sellBtn.MouseButton1Click:Connect(function()
	Remotes.Sell:FireServer()
end)
shopBtn.MouseButton1Click:Connect(function()
	shop.Visible = not shop.Visible
end)
closeBtn.MouseButton1Click:Connect(function()
	shop.Visible = false
end)

-- Respon dari server
Remotes.Notify.OnClientEvent:Connect(function(kind, a, b, c)
	if kind == "cast" then
		casting = true
		castBtn.Text = "Menunggu ikan..."
		castBtn.BackgroundColor3 = Color3.fromRGB(90, 90, 110)
	elseif kind == "catch" then
		casting = false
		castBtn.Text = "Lempar Pancing"
		castBtn.BackgroundColor3 = Color3.fromRGB(40, 150, 255)
		showToast("Dapat " .. a .. " (" .. b .. ") +" .. c, Data.COLORS[b])
	elseif kind == "sell" then
		showToast("Terjual! +" .. a .. " koin", Color3.fromRGB(255, 220, 80))
	elseif kind == "info" then
		showToast(a)
	end
end)
]]></ProtectedString>
</Properties></Item>
</Item>
