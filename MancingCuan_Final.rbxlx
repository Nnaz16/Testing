<Item class="LocalScript" referent="RBX499"><Properties><string name="Name">MancingClient</string><ProtectedString name="Source"><![CDATA[local Players = game:GetService("Players")
local RS = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local player = Players.LocalPlayer
local Data = require(RS:WaitForChild("GameData"))
local FishBuilder = require(RS:WaitForChild("FishBuilder"))
local Remotes = RS:WaitForChild("Remotes")

local D = {coins = 0, xp = 0, level = 1, rod = 1, total = 0, inv = {}, index = {}, qprog = {0, 0, 0, 0, 0}}
local boostEnd = 0
local casting = false
local autoFish = false
local bobber = nil

local fishByName = {}
for _, f in ipairs(Data.FISH) do
	fishByName[f.name] = f
end

local BG = Color3.fromRGB(20, 24, 34)
local BG2 = Color3.fromRGB(34, 40, 56)
local WHITE = Color3.new(1, 1, 1)
local GOLD = Color3.fromRGB(255, 214, 90)
local GREY = Color3.fromRGB(180, 185, 200)
local LEFT = Enum.TextXAlignment.Left

---------------------------------------------------------------- helper UI
local function make(class, props, parent)
	local obj = Instance.new(class)
	for k, v in pairs(props) do
		obj[k] = v
	end
	obj.Parent = parent
	return obj
end

local function corner(obj, r)
	make("UICorner", {CornerRadius = UDim.new(0, r or 10)}, obj)
end

local function label(parent, props)
	props.BackgroundTransparency = 1
	props.TextColor3 = props.TextColor3 or WHITE
	props.Font = props.Font or Enum.Font.GothamBold
	props.TextSize = props.TextSize or 14
	return make("TextLabel", props, parent)
end

local function button(parent, props, r)
	props.BorderSizePixel = 0
	props.TextColor3 = props.TextColor3 or WHITE
	props.Font = props.Font or Enum.Font.GothamBold
	props.TextSize = props.TextSize or 14
	local b = make("TextButton", props, parent)
	corner(b, r or 10)
	return b
end

local function clear(list)
	for _, c in ipairs(list:GetChildren()) do
		if not c:IsA("UIListLayout") then
			c:Destroy()
		end
	end
end

local function thumb(parent, fish, size, pos, weight)
	local vp = make("ViewportFrame", {
		Size = size, Position = pos, BackgroundColor3 = Color3.fromRGB(26, 32, 48), BorderSizePixel = 0,
		Ambient = Color3.fromRGB(190, 190, 205), LightColor = WHITE,
	}, parent)
	corner(vp, 8)
	local model = FishBuilder.build(fish, weight)
	model.Parent = vp
	local cam = make("Camera", {FieldOfView = 40}, vp)
	vp.CurrentCamera = cam
	local cf, sz = model:GetBoundingBox()
	local dim = math.max(sz.X, sz.Y, sz.Z)
	cam.CFrame = CFrame.lookAt(cf.Position + Vector3.new(0.9, 0.5, -1.0).Unit * dim * 1.8, cf.Position)
	return vp
end

---------------------------------------------------------------- GUI utama
local gui = make("ScreenGui", {
	Name = "MancingCuan", ResetOnSpawn = false, ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
}, player:WaitForChild("PlayerGui"))

-- HUD kiri atas
local hud = make("Frame", {
	Size = UDim2.new(0, 230, 0, 80), Position = UDim2.new(0, 10, 0, 10),
	BackgroundColor3 = BG, BackgroundTransparency = 0.15, BorderSizePixel = 0,
}, gui)
corner(hud, 12)
local lvlLabel = label(hud, {Size = UDim2.new(0, 70, 0, 22), Position = UDim2.new(0, 10, 0, 4), Text = "Lv 1", TextXAlignment = LEFT, TextSize = 16, TextColor3 = GOLD})
local coinLabel = label(hud, {Size = UDim2.new(0, 140, 0, 22), Position = UDim2.new(1, -150, 0, 4), Text = "0 Koin", TextXAlignment = Enum.TextXAlignment.Right, TextSize = 15})
local xpBack = make("Frame", {Size = UDim2.new(1, -20, 0, 10), Position = UDim2.new(0, 10, 0, 30), BackgroundColor3 = Color3.fromRGB(50, 56, 76), BorderSizePixel = 0}, hud)
corner(xpBack, 5)
local xpFill = make("Frame", {Size = UDim2.new(0, 0, 1, 0), BackgroundColor3 = Color3.fromRGB(80, 200, 255), BorderSizePixel = 0}, xpBack)
corner(xpFill, 5)
local rodLabel = label(hud, {Size = UDim2.new(1, -20, 0, 18), Position = UDim2.new(0, 10, 0, 44), Text = "", TextXAlignment = LEFT, TextSize = 12, Font = Enum.Font.Gotham})
local boostLabel = label(hud, {Size = UDim2.new(1, -20, 0, 16), Position = UDim2.new(0, 10, 0, 62), Text = "", TextXAlignment = LEFT, TextSize = 12, TextColor3 = Color3.fromRGB(120, 255, 160)})

-- notifikasi
local toast = label(gui, {
	Size = UDim2.new(0, 340, 0, 34), AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 12),
	BackgroundTransparency = 1, TextTransparency = 1, TextSize = 15, Text = "", ZIndex = 10,
})
toast.BackgroundColor3 = BG
corner(toast, 10)
local toastToken = 0
local function showToast(text, color)
	toastToken += 1
	local my = toastToken
	toast.Text = text
	toast.TextColor3 = color or WHITE
	toast.BackgroundTransparency = 0.15
	toast.TextTransparency = 0
	task.delay(2.6, function()
		if my == toastToken then
			TweenService:Create(toast, TweenInfo.new(0.4), {BackgroundTransparency = 1, TextTransparency = 1}):Play()
		end
	end)
end

local banner = label(gui, {
	Size = UDim2.new(0, 420, 0, 40), AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 52),
	BackgroundTransparency = 1, TextTransparency = 1, TextSize = 15, Text = "", ZIndex = 10, TextWrapped = true,
})
banner.BackgroundColor3 = BG
corner(banner, 10)
local bannerToken = 0
local function showBanner(text, color)
	bannerToken += 1
	local my = bannerToken
	banner.Text = text
	banner.TextColor3 = color
	banner.BackgroundTransparency = 0.1
	banner.TextTransparency = 0
	task.delay(5, function()
		if my == bannerToken then
			TweenService:Create(banner, TweenInfo.new(0.5), {BackgroundTransparency = 1, TextTransparency = 1}):Play()
		end
	end)
end

-- kartu tangkapan
local card = make("Frame", {
	Size = UDim2.new(0, 290, 0, 124), AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 98),
	BackgroundColor3 = BG, BorderSizePixel = 0, Visible = false, ZIndex = 8,
}, gui)
corner(card, 14)
local cardStroke = make("UIStroke", {Thickness = 2, Color = WHITE}, card)
local cardThumb = make("Frame", {Size = UDim2.new(0, 120, 0, 104), Position = UDim2.new(0, 10, 0, 10), BackgroundTransparency = 1}, card)
local cardName = label(card, {Size = UDim2.new(1, -146, 0, 24), Position = UDim2.new(0, 136, 0, 10), TextXAlignment = LEFT, TextSize = 16, Text = ""})
local cardRarity = label(card, {Size = UDim2.new(1, -146, 0, 18), Position = UDim2.new(0, 136, 0, 36), TextXAlignment = LEFT, TextSize = 13, Text = ""})
local cardInfo = label(card, {Size = UDim2.new(1, -146, 0, 18), Position = UDim2.new(0, 136, 0, 56), TextXAlignment = LEFT, TextSize = 13, Font = Enum.Font.Gotham, Text = ""})
local cardPrice = label(card, {Size = UDim2.new(1, -146, 0, 18), Position = UDim2.new(0, 136, 0, 76), TextXAlignment = LEFT, TextSize = 13, TextColor3 = GOLD, Text = ""})
local cardNew = label(card, {Size = UDim2.new(1, -146, 0, 18), Position = UDim2.new(0, 136, 0, 98), TextXAlignment = LEFT, TextSize = 11, TextColor3 = Color3.fromRGB(120, 255, 160), Text = ""})
local cardToken = 0

local function showCatch(fish, weight, price, isNew)
	cardToken += 1
	local my = cardToken
	for _, c in ipairs(cardThumb:GetChildren()) do
		c:Destroy()
	end
	thumb(cardThumb, fish, UDim2.new(1, 0, 1, 0), UDim2.new(0, 0, 0, 0), weight)
	local col = Data.COLORS[fish.rarity]
	cardStroke.Color = col
	cardName.Text = fish.name
	cardName.TextColor3 = col
	cardRarity.Text = fish.rarity
	cardRarity.TextColor3 = col
	cardInfo.Text = weight .. " kg"
	cardPrice.Text = "Nilai: " .. price .. " koin"
	cardNew.Text = isNew and "BARU DI KOLEKSI!" or ""
	card.Visible = true
	task.delay(3.5, function()
		if my == cardToken then
			card.Visible = false
		end
	end)
end

-- tombol pancing
local castBtn = button(gui, {
	Size = UDim2.new(0, 200, 0, 54), AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -16),
	BackgroundColor3 = Color3.fromRGB(40, 150, 255), Text = "", ClipsDescendants = true,
}, 14)
local castFill = make("Frame", {Size = UDim2.new(0, 0, 1, 0), BackgroundColor3 = WHITE, BackgroundTransparency = 0.75, BorderSizePixel = 0}, castBtn)
local castText = label(castBtn, {Size = UDim2.new(1, 0, 1, 0), Text = "Lempar Pancing", TextSize = 18, ZIndex = 2})

---------------------------------------------------------------- panel
local panels = {}
local refreshers = {}

local function makePanel(key, title)
	local frame = make("Frame", {
		Name = key, Size = UDim2.new(0.62, 0, 0.78, 0), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, 0.5, 0),
		BackgroundColor3 = BG, BorderSizePixel = 0, Visible = false, ZIndex = 5,
	}, gui)
	corner(frame, 14)
	make("UISizeConstraint", {MaxSize = Vector2.new(560, 340), MinSize = Vector2.new(280, 220)}, frame)
	label(frame, {Size = UDim2.new(1, -60, 0, 34), Position = UDim2.new(0, 14, 0, 2), Text = title, TextXAlignment = LEFT, TextSize = 18})
	local close = button(frame, {Size = UDim2.new(0, 30, 0, 30), Position = UDim2.new(1, -38, 0, 5), BackgroundColor3 = Color3.fromRGB(190, 60, 60), Text = "X"}, 8)
	close.MouseButton1Click:Connect(function()
		frame.Visible = false
	end)
	local header = make("Frame", {Size = UDim2.new(1, -24, 0, 28), Position = UDim2.new(0, 12, 0, 38), BackgroundTransparency = 1}, frame)
	local headerText = label(header, {Size = UDim2.new(1, -120, 1, 0), TextXAlignment = LEFT, TextSize = 14, TextColor3 = GOLD, Text = ""})
	local list = make("ScrollingFrame", {
		Size = UDim2.new(1, -24, 1, -76), Position = UDim2.new(0, 12, 0, 70), BackgroundTransparency = 1, BorderSizePixel = 0,
		ScrollBarThickness = 4, AutomaticCanvasSize = Enum.AutomaticSize.Y, CanvasSize = UDim2.new(0, 0, 0, 0),
	}, frame)
	make("UIListLayout", {Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder}, list)
	panels[key] = {frame = frame, header = header, headerText = headerText, list = list}
	return panels[key]
end

local function openPanel(key)
	for k, p in pairs(panels) do
		p.frame.Visible = (k == key) and not p.frame.Visible
	end
	if panels[key].frame.Visible and refreshers[key] then
		refreshers[key]()
	end
end

local function newRow(list, height, order)
	local r = make("Frame", {Size = UDim2.new(1, -8, 0, height), BackgroundColor3 = BG2, BorderSizePixel = 0, LayoutOrder = order}, list)
	corner(r, 10)
	return r
end

-- Tas (inventori)
local inv = makePanel("inv", "Tas Ikan")
local sellAllBtn = button(inv.header, {Size = UDim2.new(0, 110, 0, 26), Position = UDim2.new(1, -110, 0, 1), BackgroundColor3 = Color3.fromRGB(60, 180, 90), Text = "Jual Semua", TextSize = 13}, 8)
sellAllBtn.MouseButton1Click:Connect(function()
	Remotes.Sell:FireServer()
end)
refreshers.inv = function()
	clear(inv.list)
	local total, count = 0, 0
	for i, f in ipairs(Data.FISH) do
		local e = D.inv[f.name]
		if e and e.n > 0 then
			total += e.v
			count += e.n
			local r = newRow(inv.list, 56, i)
			thumb(r, f, UDim2.new(0, 80, 0, 44), UDim2.new(0, 6, 0, 6), nil)
			label(r, {Size = UDim2.new(1, -100, 0, 22), Position = UDim2.new(0, 94, 0, 6), Text = f.name .. "  x" .. e.n, TextXAlignment = LEFT, TextColor3 = Data.COLORS[f.rarity], TextSize = 15})
			label(r, {Size = UDim2.new(1, -100, 0, 18), Position = UDim2.new(0, 94, 0, 30), Text = "Nilai: " .. e.v .. " koin", TextXAlignment = LEFT, TextSize = 12, Font = Enum.Font.Gotham, TextColor3 = GOLD})
		end
	end
	if count == 0 then
		label(inv.list, {Size = UDim2.new(1, -8, 0, 40), Text = "Tas kosong. Ayo memancing!", TextColor3 = GREY, TextSize = 14})
	end
	inv.headerText.Text = count .. " ikan  |  " .. total .. " koin"
end

-- Koleksi
local idx = makePanel("index", "Koleksi Ikan")
refreshers.index = function()
	clear(idx.list)
	local found = 0
	for i, f in ipairs(Data.FISH) do
		local e = D.index[f.name]
		local r = newRow(idx.list, 62, i)
		local zoneName = f.zone == "Kolam" and "Danau" or "Laut"
		if e then
			found += 1
			thumb(r, f, UDim2.new(0, 84, 0, 50), UDim2.new(0, 6, 0, 6), nil)
			label(r, {Size = UDim2.new(1, -104, 0, 20), Position = UDim2.new(0, 98, 0, 6), Text = f.name, TextXAlignment = LEFT, TextColor3 = Data.COLORS[f.rarity], TextSize = 15})
			label(r, {Size = UDim2.new(1, -104, 0, 30), Position = UDim2.new(0, 98, 0, 28), Text = f.rarity .. " | " .. zoneName .. " | Terberat " .. e.maxW .. " kg | x" .. e.n, TextXAlignment = LEFT, TextSize = 11, Font = Enum.Font.Gotham, TextColor3 = GREY, TextWrapped = true})
		else
			label(r, {Size = UDim2.new(1, -20, 1, 0), Position = UDim2.new(0, 14, 0, 0), Text = "???  (" .. f.rarity .. ", " .. zoneName .. (f.night and ", malam hari" or "") .. ")", TextXAlignment = LEFT, TextColor3 = Color3.fromRGB(110, 115, 135), TextSize = 13})
		end
	end
	idx.headerText.Text = "Koleksi: " .. found .. "/" .. #Data.FISH
end

-- Toko
local shop = makePanel("shop", "Toko Pancing")
refreshers.shop = function()
	clear(shop.list)
	shop.headerText.Text = "Koin: " .. D.coins
	local order = 0
	order += 1
	label(shop.list, {Size = UDim2.new(1, -8, 0, 22), Text = "PANCING", TextXAlignment = LEFT, TextSize = 13, TextColor3 = GOLD, LayoutOrder = order})
	for i, rod in ipairs(Data.RODS) do
		order += 1
		local r = newRow(shop.list, 56, order)
		label(r, {Size = UDim2.new(0.58, 0, 1, 0), Position = UDim2.new(0, 10, 0, 0), Text = rod.name .. "\nLuck x" .. rod.luck .. "  |  Tunggu " .. rod.speed .. "s", TextXAlignment = LEFT, TextSize = 12, Font = Enum.Font.Gotham})
		local b = button(r, {Size = UDim2.new(0, 100, 0, 38), Position = UDim2.new(1, -108, 0.5, -19), TextSize = 13, Text = ""}, 8)
		if i < D.rod then
			b.Text = "Dimiliki"
			b.BackgroundColor3 = Color3.fromRGB(90, 90, 100)
		elseif i == D.rod then
			b.Text = "Dipakai"
			b.BackgroundColor3 = Color3.fromRGB(60, 180, 90)
		else
			b.Text = "Beli " .. rod.price
			b.BackgroundColor3 = Color3.fromRGB(230, 160, 40)
			b.MouseButton1Click:Connect(function()
				Remotes.BuyRod:FireServer(i)
			end)
		end
	end
	order += 1
	label(shop.list, {Size = UDim2.new(1, -8, 0, 22), Text = "ITEM", TextXAlignment = LEFT, TextSize = 13, TextColor3 = GOLD, LayoutOrder = order})
	order += 1
	local r = newRow(shop.list, 56, order)
	label(r, {Size = UDim2.new(0.58, 0, 1, 0), Position = UDim2.new(0, 10, 0, 0), Text = "Ramuan Luck x2\nAktif " .. math.floor(Data.BOOST_SECONDS / 60) .. " menit", TextXAlignment = LEFT, TextSize = 12, Font = Enum.Font.Gotham})
	local b = button(r, {Size = UDim2.new(0, 100, 0, 38), Position = UDim2.new(1, -108, 0.5, -19), TextSize = 13, Text = "Beli " .. Data.BOOST_PRICE, BackgroundColor3 = Color3.fromRGB(230, 160, 40)}, 8)
	b.MouseButton1Click:Connect(function()
		Remotes.BuyBoost:FireServer()
	end)
end

-- Misi
local quest = makePanel("quest", "Papan Misi")
refreshers.quest = function()
	clear(quest.list)
	quest.headerText.Text = "Selesaikan misi, dapat koin!"
	for i, q in ipairs(Data.QUESTS) do
		local prog = D.qprog[i] or 0
		local r = newRow(quest.list, 62, i)
		label(r, {Size = UDim2.new(0.62, 0, 0, 22), Position = UDim2.new(0, 10, 0, 6), Text = q.text, TextXAlignment = LEFT, TextSize = 13, TextWrapped = true})
		label(r, {Size = UDim2.new(0.62, 0, 0, 16), Position = UDim2.new(0, 10, 0, 28), Text = math.min(prog, q.goal) .. "/" .. q.goal .. "  |  Hadiah " .. q.reward .. " koin", TextXAlignment = LEFT, TextSize = 11, Font = Enum.Font.Gotham, TextColor3 = GOLD})
		local back = make("Frame", {Size = UDim2.new(0.6, 0, 0, 6), Position = UDim2.new(0, 10, 0, 48), BackgroundColor3 = Color3.fromRGB(50, 56, 76), BorderSizePixel = 0}, r)
		corner(back, 3)
		local fill = make("Frame", {Size = UDim2.new(math.clamp(prog / q.goal, 0, 1), 0, 1, 0), BackgroundColor3 = Color3.fromRGB(80, 200, 255), BorderSizePixel = 0}, back)
		corner(fill, 3)
		local done = prog >= q.goal
		local b = button(r, {Size = UDim2.new(0, 90, 0, 36), Position = UDim2.new(1, -98, 0.5, -18), TextSize = 13, Text = "Klaim", BackgroundColor3 = done and Color3.fromRGB(60, 180, 90) or Color3.fromRGB(90, 90, 100)}, 8)
		b.MouseButton1Click:Connect(function()
			Remotes.ClaimQuest:FireServer(i)
		end)
	end
end

-- Peta (teleport)
local map = makePanel("map", "Peta / Teleport")
refreshers.map = function()
	clear(map.list)
	map.headerText.Text = "Pilih tujuan"
	for i, t in ipairs(Data.TELEPORTS) do
		local locked = D.level < t.minLevel
		local b = button(map.list, {Size = UDim2.new(1, -8, 0, 44), LayoutOrder = i, TextSize = 14,
			Text = locked and (t.name .. "  (Level " .. t.minLevel .. ")") or t.name,
			BackgroundColor3 = locked and Color3.fromRGB(70, 70, 85) or Color3.fromRGB(40, 110, 190)}, 10)
		b.MouseButton1Click:Connect(function()
			Remotes.Teleport:FireServer(t.key)
			panels.map.frame.Visible = false
		end)
	end
end

---------------------------------------------------------------- menu kanan
local menu = make("Frame", {
	Size = UDim2.new(0, 66, 0, 290), AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -8, 0.5, 0), BackgroundTransparency = 1,
}, gui)
make("UIListLayout", {Padding = UDim.new(0, 5), HorizontalAlignment = Enum.HorizontalAlignment.Center, VerticalAlignment = Enum.VerticalAlignment.Center, SortOrder = Enum.SortOrder.LayoutOrder}, menu)

local function menuButton(text, order, color)
	return button(menu, {Size = UDim2.new(0, 64, 0, 42), Text = text, TextSize = 13, BackgroundColor3 = color, LayoutOrder = order}, 10)
end

menuButton("Tas", 1, Color3.fromRGB(60, 150, 90)).MouseButton1Click:Connect(function() openPanel("inv") end)
menuButton("Koleksi", 2, Color3.fromRGB(140, 90, 200)).MouseButton1Click:Connect(function() openPanel("index") end)
menuButton("Toko", 3, Color3.fromRGB(230, 160, 40)).MouseButton1Click:Connect(function() openPanel("shop") end)
menuButton("Misi", 4, Color3.fromRGB(200, 90, 90)).MouseButton1Click:Connect(function() openPanel("quest") end)
menuButton("Peta", 5, Color3.fromRGB(40, 110, 190)).MouseButton1Click:Connect(function() openPanel("map") end)
local autoBtn = menuButton("Auto: OFF", 6, Color3.fromRGB(90, 90, 100))
autoBtn.MouseButton1Click:Connect(function()
	autoFish = not autoFish
	autoBtn.Text = autoFish and "Auto: ON" or "Auto: OFF"
	autoBtn.BackgroundColor3 = autoFish and Color3.fromRGB(60, 180, 90) or Color3.fromRGB(90, 90, 100)
	if autoFish and not casting then
		Remotes.Cast:FireServer()
	end
end)

---------------------------------------------------------------- efek dunia
local function stopBobber()
	if bobber then
		bobber:Destroy()
		bobber = nil
	end
end

local function startBobber(target)
	stopBobber()
	local mine = Instance.new("Part")
	mine.Name = "Pelampung"
	mine.Shape = Enum.PartType.Ball
	mine.Size = Vector3.new(1.2, 1.2, 1.2)
	mine.Anchored = true
	mine.CanCollide = false
	mine.CanQuery = false
	mine.Material = Enum.Material.Neon
	mine.Color = Color3.fromRGB(255, 70, 70)
	mine.Position = target
	mine.Parent = Workspace
	bobber = mine

	local a1 = Instance.new("Attachment")
	a1.Parent = mine

	local char = player.Character
	local tool = char and char:WaitForChild("Pancing", 2)
	local handle = tool and tool:FindFirstChild("Handle")
	local tip = handle and handle:FindFirstChild("TipAttachment")
	if tip and mine.Parent then
		local beam = Instance.new("Beam")
		beam.Attachment0 = tip
		beam.Attachment1 = a1
		beam.Width0 = 0.08
		beam.Width1 = 0.08
		beam.FaceCamera = true
		beam.Parent = mine
	end

	local t = 0
	while bobber == mine and mine.Parent do
		t += 0.03
		mine.Position = target + Vector3.new(0, math.sin(t * 6) * 0.15, 0)
		task.wait(0.03)
	end
end

local function flyFish(fish, weight, fromPos)
	local char = player.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	if not hrp then return end
	local model = FishBuilder.build(fish, weight)
	model.Parent = Workspace
	local startPos = fromPos
	local t0 = os.clock()
	while true do
		local a = (os.clock() - t0) / 0.8
		if a >= 1 then break end
		local endPos = hrp.Position + Vector3.new(0, 6, 0)
		local pos = startPos:Lerp(endPos, a) + Vector3.new(0, math.sin(a * math.pi) * 8, 0)
		model:PivotTo(CFrame.new(pos) * CFrame.Angles(0, a * math.pi * 4, 0))
		RunService.Heartbeat:Wait()
	end
	local hold = os.clock()
	while os.clock() - hold < 1.6 do
		local pos = hrp.Position + Vector3.new(0, 6, 0)
		model:PivotTo(CFrame.new(pos) * CFrame.Angles(0, (os.clock() - hold) * 2, 0))
		RunService.Heartbeat:Wait()
	end
	model:Destroy()
end

---------------------------------------------------------------- HUD + data
local function updateHUD()
	local rod = Data.RODS[D.rod] or Data.RODS[1]
	lvlLabel.Text = "Lv " .. D.level
	coinLabel.Text = D.coins .. " Koin"
	xpFill.Size = UDim2.new(math.clamp(D.xp / Data.xpNeeded(D.level), 0, 1), 0, 1, 0)
	rodLabel.Text = rod.name .. "  (Luck x" .. rod.luck .. ")"
	local left = math.max(0, math.floor(boostEnd - os.clock()))
	if left > 0 then
		boostLabel.Text = string.format("Ramuan Luck x2: %d:%02d", math.floor(left / 60), left % 60)
	else
		boostLabel.Text = ""
	end
end

Remotes.Sync.OnClientEvent:Connect(function(t)
	D = t
	boostEnd = os.clock() + (t.boostLeft or 0)
	updateHUD()
	for key, p in pairs(panels) do
		if p.frame.Visible and refreshers[key] then
			refreshers[key]()
		end
	end
end)

task.spawn(function()
	while true do
		task.wait(0.5)
		updateHUD()
	end
end)

castBtn.MouseButton1Click:Connect(function()
	if casting then return end
	Remotes.Cast:FireServer()
end)

local promptMap = {sell = "inv", shop = "shop", quest = "quest"}

Remotes.Notify.OnClientEvent:Connect(function(kind, a, b, c, d, e)
	if kind == "cast" then
		casting = true
		castText.Text = "Menunggu ikan..."
		castBtn.BackgroundColor3 = Color3.fromRGB(90, 90, 110)
		castFill.Size = UDim2.new(0, 0, 1, 0)
		TweenService:Create(castFill, TweenInfo.new(b, Enum.EasingStyle.Linear), {Size = UDim2.new(1, 0, 1, 0)}):Play()
		task.spawn(startBobber, a)
	elseif kind == "catch" then
		casting = false
		castText.Text = "Lempar Pancing"
		castBtn.BackgroundColor3 = Color3.fromRGB(40, 150, 255)
		castFill.Size = UDim2.new(0, 0, 1, 0)
		local fish = fishByName[a]
		local from = bobber and bobber.Position
		if not from then
			local char = player.Character
			from = char and char:GetPivot().Position or Vector3.new(0, 5, 0)
		end
		stopBobber()
		if fish then
			showCatch(fish, c, d, e)
			task.spawn(flyFish, fish, c, from)
		end
		if autoFish then
			task.delay(3, function()
				if autoFish and not casting then
					Remotes.Cast:FireServer()
				end
			end)
		end
	elseif kind == "sell" then
		showToast("Terjual " .. b .. " ikan! +" .. a .. " koin", GOLD)
	elseif kind == "levelup" then
		showToast("LEVEL UP! Lv " .. a .. "  (+" .. b .. " koin)", GOLD)
	elseif kind == "global" then
		showBanner(a .. " menangkap " .. b .. " (" .. c .. ") seberat " .. d .. " kg!", Data.COLORS[c])
	elseif kind == "open" then
		local key = promptMap[a]
		if key then
			for k, p in pairs(panels) do
				p.frame.Visible = (k == key)
			end
			if refreshers[key] then
				refreshers[key]()
			end
		end
	elseif kind == "info" then
		showToast(a)
	end
end)

updateHUD()
]]></ProtectedString></Properties></Item>
