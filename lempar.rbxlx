				<string name="Name">Bola Lempar</string>
				<string name="ToolTip">Tap untuk melempar</string>
				<bool name="CanBeDropped">false</bool>
				<bool name="RequiresHandle">true</bool>
			</Properties>
			<Item class="Part" referent="RBX8">
				<Properties>
					<string name="Name">Handle</string>
					<token name="shape">0</token>
					<Vector3 name="size"><X>1.5</X><Y>1.5</Y><Z>1.5</Z></Vector3>
					<Color3uint8 name="Color3uint8">4294198070</Color3uint8>
				</Properties>
			</Item>
			<Item class="LocalScript" referent="RBX9">
				<Properties>
					<string name="Name">LemparTool</string>
					<ProtectedString name="Source"><![CDATA[
-- Lempar benda dari Tool (tap untuk melempar)
local tool = script.Parent
local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local Debris = game:GetService("Debris")

-- PENGATURAN
local KEKUATAN = 80
local TINGGI = 25
local COOLDOWN = 1

local sibuk = false

local function getArm(char)
	local upper = char:FindFirstChild("RightUpperArm")
	if upper then
		return upper:FindFirstChild("RightShoulder")
	end
	local torso = char:FindFirstChild("Torso")
	if torso then
		return torso:FindFirstChild("Right Shoulder")
	end
end

local function rotasi(shoulder, c0, derajat)
	if shoulder.Part0 and shoulder.Part0.Name == "Torso" then
		return c0 * CFrame.Angles(0, 0, math.rad(derajat)) -- R6
	end
	return c0 * CFrame.Angles(math.rad(derajat), 0, 0) -- R15
end

tool.Activated:Connect(function()
	if sibuk then return end
	local char = tool.Parent
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	local shoulder = char and getArm(char)
	local handle = tool:FindFirstChild("Handle")
	if not (hrp and shoulder and handle) then return end

	sibuk = true
	local c0Asli = shoulder.C0

	local t1 = TweenService:Create(shoulder, TweenInfo.new(0.25, Enum.EasingStyle.Quad), {C0 = rotasi(shoulder, c0Asli, -100)})
	t1:Play()
	t1.Completed:Wait()

	local t2 = TweenService:Create(shoulder, TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {C0 = rotasi(shoulder, c0Asli, 150)})
	t2:Play()
	task.wait(0.07)

	-- Lepas salinan benda (tool tetap di tangan)
	local proyektil = handle:Clone()
	proyektil.Name = "Proyektil"
	proyektil.Anchored = false
	proyektil.CanCollide = true
	proyektil.CFrame = hrp.CFrame * CFrame.new(1.5, 1, -2.5)
	proyektil.Parent = workspace
	proyektil.AssemblyLinearVelocity = hrp.CFrame.LookVector * KEKUATAN + Vector3.new(0, TINGGI, 0)
	Debris:AddItem(proyektil, 6)

	t2.Completed:Wait()

	local t3 = TweenService:Create(shoulder, TweenInfo.new(0.3, Enum.EasingStyle.Quad), {C0 = c0Asli})
	t3:Play()
	t3.Completed:Wait()

	task.wait(COOLDOWN)
	sibuk = false
end)

tool.Unequipped:Connect(function()
	sibuk = false
end)
]]></ProtectedString>
				</Properties>
			</Item>
		</Item>
	</Item>
</roblox>
