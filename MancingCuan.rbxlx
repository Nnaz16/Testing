<Item class="ModuleScript" referent="RBX10"><Properties>
<string name="Name">GameData</string>
<ProtectedString name="Source"><![CDATA[local Data = {}

Data.FISH = {
	{name = "Ikan Teri",   rarity = "Common",    price = 5,    weight = 50},
	{name = "Ikan Mas",    rarity = "Common",    price = 8,    weight = 35},
	{name = "Ikan Lele",   rarity = "Uncommon",  price = 20,   weight = 25},
	{name = "Ikan Koi",    rarity = "Rare",      price = 60,   weight = 10},
	{name = "Hiu Mini",    rarity = "Epic",      price = 200,  weight = 3},
	{name = "Paus Emas",   rarity = "Legendary", price = 1000, weight = 0.5},
}

Data.RODS = {
	{name = "Pancing Kayu",  price = 0,    luck = 1,   speed = 4},
	{name = "Pancing Besi",  price = 150,  luck = 1.5, speed = 3.2},
	{name = "Pancing Emas",  price = 600,  luck = 2.5, speed = 2.5},
	{name = "Pancing Neon",  price = 2500, luck = 5,   speed = 1.8},
}

Data.COLORS = {
	Common    = Color3.fromRGB(200, 200, 200),
	Uncommon  = Color3.fromRGB(90, 220, 120),
	Rare      = Color3.fromRGB(80, 160, 255),
	Epic      = Color3.fromRGB(190, 100, 255),
	Legendary = Color3.fromRGB(255, 200, 40),
}

return Data
]]></ProtectedString>
</Properties></Item>
</Item>
<Item class="ServerScriptService" referent="RBX13"><Properties>
<string name="Name">ServerScriptService</string>
</Properties>
<Item class="Script" referent="RBX12"><Properties>
<string name="Name">MancingServer</string>
<ProtectedString name="Source"><![CDATA[local Players = game:GetService("Players")
local RS = game:GetService("ReplicatedStorage")

local Data = require(RS:WaitForChild("GameData"))
local Remotes = RS:WaitForChild("Remotes")
local CastEvent = Remotes:WaitForChild("Cast")
local SellEvent = Remotes:WaitForChild("Sell")
local BuyEvent = Remotes:WaitForChild("BuyRod")
local Notify = Remotes:WaitForChild("Notify")

local state = {}

local function pickFish(luck)
	local weights, total = {}, 0
	for i, f in ipairs(Data.FISH) do
		local w = f.weight
		if f.price >= 60 then
			w = w * luck
		end
		weights[i] = w
		total += w
	end
	local r = math.random() * total
	for i, w in ipairs(weights) do
		r -= w
		if r <= 0 then
			return Data.FISH[i]
		end
	end
	return Data.FISH[1]
end

local function setup(plr)
	local ls = Instance.new("Folder")
	ls.Name = "leaderstats"

	local coins = Instance.new("IntValue")
	coins.Name = "Koin"
	coins.Value = 0
	coins.Parent = ls

	local fish = Instance.new("IntValue")
	fish.Name = "Ikan"
	fish.Value = 0
	fish.Parent = ls

	local rod = Instance.new("IntValue")
	rod.Name = "Pancing"
	rod.Value = 1
	rod.Parent = ls

	ls.Parent = plr
	state[plr] = {value = 0, busy = false}
end

Players.PlayerAdded:Connect(setup)
for _, plr in ipairs(Players:GetPlayers()) do
	setup(plr)
end

Players.PlayerRemoving:Connect(function(plr)
	state[plr] = nil
end)

CastEvent.OnServerEvent:Connect(function(plr)
	local s = state[plr]
	local ls = plr:FindFirstChild("leaderstats")
	if not s or not ls or s.busy then return end
	s.busy = true

	local rodData = Data.RODS[ls.Pancing.Value]
	local waitTime = rodData.speed + math.random() * 2
	Notify:FireClient(plr, "cast", waitTime)
	task.wait(waitTime)

	if not plr.Parent or not state[plr] then return end
	local f = pickFish(rodData.luck)
	s.value += f.price
	ls.Ikan.Value += 1
	s.busy = false
	Notify:FireClient(plr, "catch", f.name, f.rarity, f.price)
end)

SellEvent.OnServerEvent:Connect(function(plr)
	local s = state[plr]
	local ls = plr:FindFirstChild("leaderstats")
	if not s or not ls then return end
	if ls.Ikan.Value <= 0 then
		Notify:FireClient(plr, "info", "Belum ada ikan untuk dijual!")
		return
	end
	local earned = s.value
	ls.Koin.Value += earned
	ls.Ikan.Value = 0
	s.value = 0
	Notify:FireClient(plr, "sell", earned)
end)

BuyEvent.OnServerEvent:Connect(function(plr, index)
	local ls = plr:FindFirstChild("leaderstats")
	if not ls or type(index) ~= "number" then return end
	local rod = Data.RODS[index]
	if not rod or index <= ls.Pancing.Value then return end
	if ls.Koin.Value < rod.price then
		Notify:FireClient(plr, "info", "Koin kamu kurang!")
		return
	end
	ls.Koin.Value -= rod.price
	ls.Pancing.Value = index
	Notify:FireClient(plr, "info", "Kamu sekarang pakai " .. rod.name .. "!")
end)
]]></ProtectedString>
</Properties></Item>
</Item>
<Item class="StarterPlayer" referent="RBX17"><Properties>
<string name="Name">StarterPlayer</string>
</Properties>
<Item class="StarterPlayerScripts" referent="RBX15"><Properties>
