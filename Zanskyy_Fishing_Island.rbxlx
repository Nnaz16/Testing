  <Item class="ServerScriptService">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Script">
      <Properties>
        <string name="Name">FishingServer</string>
        <ProtectedString name="Source">
local Players=game:GetService("Players")
local ReplicatedStorage=game:GetService("ReplicatedStorage")
local rem=ReplicatedStorage:WaitForChild("FishingRemotes")
local cast=rem:WaitForChild("Cast")
local action=rem:WaitForChild("Action")
local fishData={{name="Bluegill",value=8,weight=1},{name="Clownfish",value=15,weight=1.3},{name="Tuna",value=40,weight=2},{name="Golden Carp",value=120,weight=3}}
local rodNames={"Starter Rod","Reinforced Rod","Pro Rod"}
local prices={0,250,1000}
local function setup(p)
 p:SetAttribute("Coins",100)
 p:SetAttribute("RodLevel",1)
 p:SetAttribute("FishCount",0)
 local inv=Instance.new("Folder"); inv.Name="FishInventory"; inv.Parent=p
end
Players.PlayerAdded:Connect(setup)
local cooldown={}
cast.OnServerEvent:Connect(function(p)
 if cooldown[p] then return end; cooldown[p]=true
 if not p.Character or not p.Character:FindFirstChild("HumanoidRootPart") then cooldown[p]=nil; return end
 task.wait(2.5)
 local level=p:GetAttribute("RodLevel") or 1
 local pick=math.random(1, math.min(#fishData,level+1))
 local f=fishData[pick]
 local inv=p:FindFirstChild("FishInventory")
 if inv then
  local v=Instance.new("StringValue"); v.Name=f.name; v.Value=tostring(f.value); v.Parent=inv
  p:SetAttribute("FishCount",(p:GetAttribute("FishCount") or 0)+1)
 end
 action:FireClient(p,"Caught",f.name,f.value)
 task.wait(1); cooldown[p]=nil
end)
action.OnServerEvent:Connect(function(p,what)
 if what=="Sell" then
  local inv=p:FindFirstChild("FishInventory"); if not inv then return end
  local total=0
  for _,f in ipairs(inv:GetChildren()) do total+=tonumber(f.Value) or 0; f:Destroy() end
  p:SetAttribute("Coins",(p:GetAttribute("Coins") or 0)+total)
  p:SetAttribute("FishCount",0)
  action:FireClient(p,"Sold",total)
 elseif what=="BuyRod" then
  local level=p:GetAttribute("RodLevel") or 1
  if level&gt;=3 then action:FireClient(p,"Notice","You already own the best rod!") return end
  local cost=prices[level+1]
  local coins=p:GetAttribute("Coins") or 0
  if coins&gt;=cost then
   p:SetAttribute("Coins",coins-cost); p:SetAttribute("RodLevel",level+1)
   action:FireClient(p,"Notice","Bought "..rodNames[level+1].."!")
  else action:FireClient(p,"Notice","Not enough coins!") end
 end
end)
</ProtectedString>
      </Properties>
    </Item>
  </Item>
  <Item class="StarterPack">
    <Properties>
      <string name="Name">StarterPack</string>
    </Properties>
    <Item class="Tool">
      <Properties>
        <string name="Name">Starter Rod</string>
        <bool name="RequiresHandle">true</bool>
        <bool name="CanBeDropped">true</bool>
      </Properties>
      <Item class="Part">
        <Properties>
          <string name="Name">Handle</string>
          <Vector3 name="Position">0, 0, 0</Vector3>
          <Vector3 name="Size">1, 4, 1</Vector3>
          <BrickColor name="BrickColor">Brown</BrickColor>
          <bool name="Anchored">false</bool>
          <bool name="CanCollide">true</bool>
          <string name="Material">Plastic</string>
        </Properties>
      </Item>
      <Item class="LocalScript">
        <Properties>
          <string name="Name">RodClient</string>
          <ProtectedString name="Source">
local tool=script.Parent
local rem=game:GetService("ReplicatedStorage"):WaitForChild("FishingRemotes")
local cast=rem:WaitForChild("Cast")
local busy=false
tool.Activated:Connect(function()
 if busy then return end; busy=true
 cast:FireServer()
 -- simple casting pose using shoulder motor tween, then restore
 local char=tool.Parent; local hum=char:FindFirstChildOfClass("Humanoid")
 if hum then
  local animator=hum:FindFirstChildOfClass("Animator") or Instance.new("Animator",hum)
  -- play a short built-in tool action posture through arm joint transform
  local torso=char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso")
  local shoulder=torso and (torso:FindFirstChild("RightShoulder") or torso:FindFirstChild("Right Shoulder"))
  if shoulder then
   local old=shoulder.Transform
   shoulder.Transform=CFrame.Angles(-1.1,0,0)
   task.wait(1.1); shoulder.Transform=old
  end
 end
 task.wait(3); busy=false
end)
</ProtectedString>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="StarterGui">
    <Properties>
      <string name="Name">StarterGui</string>
    </Properties>
    <Item class="ScreenGui">
      <Properties>
        <string name="Name">FishingHUD</string>
        <bool name="ResetOnSpawn">false</bool>
      </Properties>
      <Item class="LocalScript">
        <Properties>
          <string name="Name">HUDClient</string>
          <ProtectedString name="Source">
local Players=game:GetService("Players")
local player=Players.LocalPlayer
local rem=game:GetService("ReplicatedStorage"):WaitForChild("FishingRemotes"):WaitForChild("Action")
local gui=script.Parent
local function button(name,text,pos)
 local b=Instance.new("TextButton"); b.Name=name;b.Text=text;b.Size=UDim2.new(0,160,0,44);b.Position=pos
 b.BackgroundColor3=Color3.fromRGB(22,112,145);b.TextColor3=Color3.new(1,1,1);b.TextScaled=true;b.Font=Enum.Font.GothamBold
 b.Parent=gui; local c=Instance.new("UICorner");c.CornerRadius=UDim.new(0,12);c.Parent=b
 return b
end
local stats=Instance.new("TextLabel");stats.Size=UDim2.new(0,250,0,50);stats.Position=UDim2.new(0,12,0,12);stats.BackgroundTransparency=.25;stats.BackgroundColor3=Color3.fromRGB(20,35,45);stats.TextColor3=Color3.new(1,1,1);stats.TextScaled=true;stats.Font=Enum.Font.GothamBold;stats.Parent=gui
local msg=Instance.new("TextLabel");msg.Size=UDim2.new(0,340,0,44);msg.Position=UDim2.new(.5,-170,0,70);msg.BackgroundTransparency=1;msg.TextColor3=Color3.new(1,1,1);msg.TextScaled=true;msg.Font=Enum.Font.GothamBold;msg.Parent=gui
local sell=button("Sell","SELL FISH",UDim2.new(1,-175,1,-60))
local shop=button("Shop","BUY ROD",UDim2.new(1,-175,1,-112))
sell.MouseButton1Click:Connect(function() rem:FireServer("Sell") end)
shop.MouseButton1Click:Connect(function() rem:FireServer("BuyRod") end)
local function update()
 stats.Text="Coins: "..tostring(player:GetAttribute("Coins") or 0).."   |   Fish: "..tostring(player:GetAttribute("FishCount") or 0)
end
player:GetAttributeChangedSignal("Coins"):Connect(update);player:GetAttributeChangedSignal("FishCount"):Connect(update);update()
rem.OnClientEvent:Connect(function(kind,a,b)
 if kind=="Caught" then msg.Text="Caught "..a.."  +"..b.." coins (sell them!)"
 elseif kind=="Sold" then msg.Text="Sold fish for "..a.." coins!"
 elseif kind=="Notice" then msg.Text=a end
 task.delay(3,function() msg.Text="" end)
end)
</ProtectedString>
        </Properties>
      </Item>
    </Item>
  </Item>
</roblox>