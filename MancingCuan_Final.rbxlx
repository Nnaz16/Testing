<Item class="ModuleScript" referent="RBX494"><Properties><string name="Name">GameData</string><ProtectedString name="Source"><![CDATA[local Data = {}

Data.RARITY_ORDER = {Common = 1, Uncommon = 2, Rare = 3, Epic = 4, Legendary = 5, Mythic = 6}
Data.XP = {Common = 5, Uncommon = 10, Rare = 25, Epic = 60, Legendary = 150, Mythic = 400}

Data.COLORS = {
	Common    = Color3.fromRGB(200, 200, 200),
	Uncommon  = Color3.fromRGB(90, 220, 120),
	Rare      = Color3.fromRGB(80, 160, 255),
	Epic      = Color3.fromRGB(190, 100, 255),
	Legendary = Color3.fromRGB(255, 200, 40),
	Mythic    = Color3.fromRGB(255, 80, 110),
}

Data.BOOST_PRICE = 300
Data.BOOST_SECONDS = 300

function Data.xpNeeded(level)
	return level * 60
end

-- zone: "Kolam" (danau) atau "Laut". chance = bobot peluang. minW/maxW = berat (kg)
Data.FISH = {
	{name = "Ikan Teri", zone = "Kolam", rarity = "Common", price = 5, chance = 40, minW = 0.05, maxW = 0.2,
		len = 2, h = 0.6, w = 0.4, c1 = Color3.fromRGB(170, 190, 200), c2 = Color3.fromRGB(230, 240, 245)},
	{name = "Ikan Nila", zone = "Kolam", rarity = "Common", price = 6, chance = 35, minW = 0.3, maxW = 1.5,
		len = 2.6, h = 1.1, w = 0.5, c1 = Color3.fromRGB(120, 140, 120), c2 = Color3.fromRGB(200, 210, 170)},
	{name = "Ikan Mas", zone = "Kolam", rarity = "Common", price = 8, chance = 35, minW = 0.2, maxW = 1.2,
		len = 2.4, h = 1.2, w = 0.6, c1 = Color3.fromRGB(255, 140, 40), c2 = Color3.fromRGB(255, 200, 120)},
	{name = "Ikan Lele", zone = "Kolam", rarity = "Uncommon", price = 22, chance = 22, minW = 0.5, maxW = 3,
		len = 3.4, h = 0.9, w = 0.9, c1 = Color3.fromRGB(90, 90, 100), c2 = Color3.fromRGB(180, 170, 150)},
	{name = "Ikan Gabus", zone = "Kolam", rarity = "Uncommon", price = 28, chance = 18, minW = 0.6, maxW = 3.5,
		len = 3.8, h = 1, w = 0.9, c1 = Color3.fromRGB(70, 100, 60), c2 = Color3.fromRGB(190, 190, 120)},
	{name = "Ikan Koi", zone = "Kolam", rarity = "Rare", price = 80, chance = 8, minW = 0.8, maxW = 5,
		len = 3.6, h = 1.3, w = 0.9, c1 = Color3.fromRGB(255, 255, 255), c2 = Color3.fromRGB(255, 90, 40)},
	{name = "Arwana", zone = "Kolam", rarity = "Epic", price = 320, chance = 2.5, minW = 2, maxW = 9,
		len = 5.5, h = 1.4, w = 0.9, c1 = Color3.fromRGB(230, 180, 60), c2 = Color3.fromRGB(255, 230, 140)},
	{name = "Ikan Pelangi", zone = "Kolam", rarity = "Legendary", price = 1400, chance = 0.5, minW = 1, maxW = 6,
		len = 4, h = 1.6, w = 0.8, c1 = Color3.fromRGB(255, 80, 200), c2 = Color3.fromRGB(80, 220, 255), neon = true},

	{name = "Ikan Tuna", zone = "Laut", rarity = "Uncommon", price = 45, chance = 30, minW = 5, maxW = 40,
		len = 5, h = 1.8, w = 1.2, c1 = Color3.fromRGB(60, 90, 150), c2 = Color3.fromRGB(220, 225, 235)},
	{name = "Ikan Kakap", zone = "Laut", rarity = "Rare", price = 100, chance = 14, minW = 3, maxW = 25,
		len = 4.4, h = 1.8, w = 1.1, c1 = Color3.fromRGB(220, 70, 70), c2 = Color3.fromRGB(250, 190, 170)},
	{name = "Barakuda", zone = "Laut", rarity = "Rare", price = 140, chance = 10, minW = 4, maxW = 30,
		len = 6, h = 1.1, w = 0.9, c1 = Color3.fromRGB(120, 130, 140), c2 = Color3.fromRGB(210, 215, 220)},
	{name = "Hiu Mini", zone = "Laut", rarity = "Epic", price = 380, chance = 3, minW = 20, maxW = 120,
		len = 7, h = 2, w = 1.6, c1 = Color3.fromRGB(110, 120, 135), c2 = Color3.fromRGB(235, 238, 240), bigDorsal = true},
	{name = "Pari Manta", zone = "Laut", rarity = "Epic", price = 520, chance = 2.5, minW = 50, maxW = 250,
		len = 4, h = 0.5, w = 7, c1 = Color3.fromRGB(40, 50, 70), c2 = Color3.fromRGB(240, 240, 245), shape = "flat"},
	{name = "Ubur-ubur Cahaya", zone = "Laut", rarity = "Epic", price = 450, chance = 6, minW = 0.2, maxW = 2,
		len = 2, h = 2, w = 2.4, c1 = Color3.fromRGB(120, 220, 255), c2 = Color3.fromRGB(160, 240, 255), shape = "jelly", neon = true, night = true, tcount = 7, tlen = 3.5},
	{name = "Paus Emas", zone = "Laut", rarity = "Legendary", price = 3000, chance = 0.6, minW = 800, maxW = 2500,
		len = 12, h = 4.5, w = 4, c1 = Color3.fromRGB(255, 200, 50), c2 = Color3.fromRGB(255, 235, 150), shape = "whale", neon = true},
	{name = "Kraken Kecil", zone = "Laut", rarity = "Mythic", price = 9000, chance = 0.08, minW = 30, maxW = 300,
		len = 3, h = 3, w = 3.2, c1 = Color3.fromRGB(150, 30, 50), c2 = Color3.fromRGB(190, 50, 80), shape = "jelly", tcount = 8, tlen = 5, eyes = true},
}

Data.RODS = {
	{name = "Pancing Kayu",   price = 0,     luck = 1,   speed = 4,   color = Color3.fromRGB(150, 105, 60)},
	{name = "Pancing Bambu",  price = 100,   luck = 1.3, speed = 3.5, color = Color3.fromRGB(190, 200, 90)},
	{name = "Pancing Besi",   price = 400,   luck = 1.8, speed = 3,   color = Color3.fromRGB(170, 175, 190)},
	{name = "Pancing Emas",   price = 1500,  luck = 2.6, speed = 2.4, color = Color3.fromRGB(255, 205, 60)},
	{name = "Pancing Neon",   price = 6000,  luck = 4,   speed = 1.8, color = Color3.fromRGB(60, 255, 220)},
	{name = "Pancing Kosmik", price = 25000, luck = 7,   speed = 1.2, color = Color3.fromRGB(200, 90, 255)},
}

Data.ZONES = {
	{name = "Kolam", label = "Danau", dock = Vector3.new(0, 1.5, -15), radius = 35, water = Vector3.new(0, 0.6, -60), waterR = 68, minLevel = 1},
	{name = "Laut", label = "Laut Dalam", dock = Vector3.new(300, 1.5, 70), radius = 45, water = Vector3.new(300, 0.6, -60), waterR = 148, minLevel = 5},
}

Data.TELEPORTS = {
	{key = "plaza", name = "Plaza Utama", pos = Vector3.new(0, 4, 60), minLevel = 1},
	{key = "danau", name = "Dermaga Danau", pos = Vector3.new(0, 4, 0), minLevel = 1},
	{key = "pasar", name = "Pasar Ikan", pos = Vector3.new(40, 4, 55), minLevel = 1},
	{key = "toko", name = "Toko Pancing", pos = Vector3.new(-40, 4, 55), minLevel = 1},
	{key = "laut", name = "Dermaga Laut Dalam", pos = Vector3.new(300, 4, 95), minLevel = 5},
}

Data.QUESTS = {
	{text = "Tangkap 10 ikan", kind = "catch", goal = 10, reward = 100},
	{text = "Tangkap 3 ikan Rare atau lebih", kind = "rare", goal = 3, reward = 300},
	{text = "Hasilkan 1000 koin dari menjual", kind = "earn", goal = 1000, reward = 250},
	{text = "Tangkap 5 ikan di Laut Dalam", kind = "deep", goal = 5, reward = 600},
	{text = "Tangkap 1 ikan Epic atau lebih", kind = "epic", goal = 1, reward = 800},
}

return Data
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX495"><Properties><string name="Name">FishBuilder</string><ProtectedString name="Source"><![CDATA[local RS = game:GetService("ReplicatedStorage")
local Data = require(RS:WaitForChild("GameData"))

local FishBuilder = {}

local WHITE = Color3.new(1, 1, 1)
local BLACK = Color3.fromRGB(15, 15, 20)

local function newPart(parent, name, size, cf, color, round, material)
	local p = Instance.new("Part")
	p.Name = name
	p.Anchored = true
	p.CanCollide = false
	p.CanTouch = false
	p.CanQuery = false
	p.Size = size
	p.Color = color
	p.Material = material or Enum.Material.SmoothPlastic
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.CFrame = cf
	if round then
		local m = Instance.new("SpecialMesh")
		m.MeshType = Enum.MeshType.Sphere
		m.Parent = p
	end
	p.Parent = parent
	return p
end

local function addEyes(model, x, y, z, size)
	for _, s in ipairs({-1, 1}) do
		newPart(model, "Eye", Vector3.new(size, size, size), CFrame.new(x * s, y, z), WHITE, true)
		newPart(model, "Pupil", Vector3.new(size * 0.55, size * 0.55, size * 0.55),
			CFrame.new(x * s + s * size * 0.28, y, z - size * 0.12), BLACK, true)
	end
end

-- Membangun model ikan 3D (kepala menghadap -Z). weight opsional untuk skala ukuran.
function FishBuilder.build(fish, weight)
	local k = 1
	if weight and fish.maxW > fish.minW then
		k = 0.8 + 0.4 * math.clamp((weight - fish.minW) / (fish.maxW - fish.minW), 0, 1)
	end

	local model = Instance.new("Model")
	model.Name = fish.name

	local L, H, W = fish.len * k, fish.h * k, fish.w * k
	local shape = fish.shape or "fish"
	local mat = fish.neon and Enum.Material.Neon or Enum.Material.SmoothPlastic
	local c1 = fish.c1
	local c2 = fish.c2 or fish.c1
	local origin = CFrame.new(0, 0, 0)
	local body

	if shape == "jelly" then
		body = newPart(model, "Body", Vector3.new(W, W * 0.8, W), origin, c1, true, mat)
		local count = fish.tcount or 6
		local tl = (fish.tlen or 3) * k
		for i = 1, count do
			local ang = (i / count) * math.pi * 2
			local x = math.cos(ang) * W * 0.32
			local z = math.sin(ang) * W * 0.32
			newPart(model, "Tentacle", Vector3.new(W * 0.09, tl, W * 0.09),
				CFrame.new(x, -W * 0.3 - tl / 2, z), c2, true, mat)
		end
		if fish.eyes then
			addEyes(model, W * 0.22, W * 0.1, -W * 0.42, W * 0.24)
		end
	else
		body = newPart(model, "Body", Vector3.new(W, H, L), origin, c1, true, mat)
		newPart(model, "Belly", Vector3.new(W * 1.02, H * 0.5, L * 0.82), CFrame.new(0, -H * 0.2, -L * 0.02), c2, true, mat)

		if shape == "whale" then
			newPart(model, "Tail", Vector3.new(W * 1.4, H * 0.12, L * 0.22), CFrame.new(0, H * 0.05, L * 0.58), c1, true, mat)
		elseif shape == "flat" then
			newPart(model, "Tail", Vector3.new(W * 0.04, H * 0.5, L * 0.9), CFrame.new(0, 0, L * 0.7), c1, true, mat)
		else
			newPart(model, "Tail", Vector3.new(W * 0.25, H * 1.1, L * 0.3), CFrame.new(0, 0, L * 0.58), c2, true, mat)
		end

		if shape == "fish" then
			local dh = fish.bigDorsal and H * 1 or H * 0.5
			newPart(model, "Dorsal", Vector3.new(W * 0.18, dh, L * 0.3), CFrame.new(0, H * 0.5 + dh * 0.15, L * 0.05), c2, true, mat)
		end
		if shape ~= "flat" then
			for _, s in ipairs({-1, 1}) do
				newPart(model, "Fin", Vector3.new(W * 0.5, H * 0.1, L * 0.2),
					CFrame.new(s * W * 0.55, -H * 0.15, -L * 0.1), c2, true, mat)
			end
		end

		local eyeSize = math.clamp(H * 0.28, 0.12, 1.2)
		addEyes(model, W * 0.4, H * 0.12, -L * 0.32, eyeSize)
	end

	if (Data.RARITY_ORDER[fish.rarity] or 1) >= 3 then
		local light = Instance.new("PointLight")
		light.Color = Data.COLORS[fish.rarity]
		light.Range = 8
		light.Brightness = 1.2
		light.Parent = body
	end

	model.PrimaryPart = body
	return model
end

return FishBuilder
]]></ProtectedString></Properties></Item>
</Item>
<Item class="ServerScriptService" referent="RBX498"><Properties><string name="Name">ServerScriptService</string></Properties>
<Item class="Script" referent="RBX497"><Properties><string name="Name">MancingServer</string><ProtectedString name="Source"><![CDATA[local Players = game:GetService("Players")
local RS = game:GetService("ReplicatedStorage")
local Lighting = game:GetService("Lighting")
local Workspace = game:GetService("Workspace")
local DataStoreService = game:GetService("DataStoreService")
local HttpService = game:GetService("HttpService")

local Data = require(RS:WaitForChild("GameData"))
local Remotes = RS:WaitForChild("Remotes")
local CastEvent = Remotes:WaitForChild("Cast")
local SellEvent = Remotes:WaitForChild("Sell")
local BuyRodEvent = Remotes:WaitForChild("BuyRod")
local BuyBoostEvent = Remotes:WaitForChild("BuyBoost")
local TeleportEvent = Remotes:WaitForChild("Teleport")
local ClaimEvent = Remotes:WaitForChild("ClaimQuest")
local SyncEvent = Remotes:WaitForChild("Sync")
local Notify = Remotes:WaitForChild("Notify")

local store = nil
pcall(function()
	store = DataStoreService:GetDataStore("MancingCuanV1")
end)

local sessions = {}
local busy = {}

---------------------------------------------------------------- data
local function newData()
	return {
		coins = 0, xp = 0, level = 1, rod = 1, total = 0,
		inv = {}, index = {}, qprog = {0, 0, 0, 0, 0}, boostUntil = 0,
	}
end

local function loadData(plr)
	local d = newData()
	if store then
		local ok, result = pcall(function()
			return store:GetAsync("p_" .. plr.UserId)
		end)
		if ok and type(result) == "string" then
			local ok2, decoded = pcall(function()
				return HttpService:JSONDecode(result)
			end)
			if ok2 and type(decoded) == "table" then
				for key, value in pairs(decoded) do
					if d[key] ~= nil and type(value) == type(d[key]) then
						d[key] = value
					end
				end
			end
		end
	end
	for i = 1, #Data.QUESTS do
		d.qprog[i] = tonumber(d.qprog[i]) or 0
	end
	d.rod = math.clamp(math.floor(d.rod), 1, #Data.RODS)
	d.level = math.max(1, math.floor(d.level))
	return d
end

local function saveData(plr)
	local d = sessions[plr]
	if not d or not store then return end
	pcall(function()
		store:SetAsync("p_" .. plr.UserId, HttpService:JSONEncode(d))
	end)
end

local function refresh(plr)
	local d = sessions[plr]
	local ls = plr:FindFirstChild("leaderstats")
	if not d or not ls then return end
	ls.Koin.Value = d.coins
	ls.Level.Value = d.level
	ls.Tangkapan.Value = d.total
	SyncEvent:FireClient(plr, {
		coins = d.coins, xp = d.xp, level = d.level, rod = d.rod, total = d.total,
		inv = d.inv, index = d.index, qprog = d.qprog,
		boostLeft = math.max(0, d.boostUntil - os.time()),
	})
end

---------------------------------------------------------------- pancing (tool)
local function giveRod(plr)
	local d = sessions[plr]
	if not d then return end
	local rod = Data.RODS[d.rod]

	local containers = {plr:FindFirstChildOfClass("Backpack"), plr.Character}
	for _, container in ipairs(containers) do
		for _, c in ipairs(container:GetChildren()) do
			if c:IsA("Tool") and c.Name == "Pancing" then
				c:Destroy()
			end
		end
	end

	local backpack = plr:FindFirstChildOfClass("Backpack")
	if not backpack then return end

	local tool = Instance.new("Tool")
	tool.Name = "Pancing"
	tool.RequiresHandle = true
	tool.CanBeDropped = false
	tool.GripPos = Vector3.new(0, 0, 1.5)

	local handle = Instance.new("Part")
	handle.Name = "Handle"
	handle.Size = Vector3.new(0.3, 0.3, 5)
	handle.Color = rod.color
	handle.Material = Enum.Material.SmoothPlastic
	handle.CanCollide = false
	handle.Parent = tool

	local tip = Instance.new("Attachment")
	tip.Name = "TipAttachment"
	tip.Position = Vector3.new(0, 0, -2.5)
	tip.Parent = handle

	tool.Parent = backpack
end

local function equipRod(plr)
	local char = plr.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if not hum then return end
	if char:FindFirstChild("Pancing") then return end
	local tool = plr.Backpack:FindFirstChild("Pancing")
	if tool then
		hum:EquipTool(tool)
	end
end

---------------------------------------------------------------- logika ikan
local function isNight()
	local t = Lighting.ClockTime
	return t >= 19 or t < 5
end

local function pickFish(zoneName, luck)
	local pool, total = {}, 0
	local night = isNight()
	for _, f in ipairs(Data.FISH) do
		if f.zone == zoneName and (not f.night or night) then
			local w = f.chance
			if Data.RARITY_ORDER[f.rarity] >= 3 then
				w = w * luck
			end
			table.insert(pool, {fish = f, w = w})
			total += w
		end
	end
	local r = math.random() * total
	for _, e in ipairs(pool) do
		r -= e.w
		if r <= 0 then
			return e.fish
		end
	end
	return pool[1].fish
end

local function flat(v)
	return Vector3.new(v.X, 0, v.Z)
end

local function getZone(hrp)
	for _, z in ipairs(Data.ZONES) do
		if (flat(hrp.Position) - flat(z.dock)).Magnitude <= z.radius then
			return z
		end
	end
	return nil
end

local function addXp(plr, d, amount)
	d.xp += amount
	while d.xp >= Data.xpNeeded(d.level) do
		d.xp -= Data.xpNeeded(d.level)
		d.level += 1
		local bonus = d.level * 50
		d.coins += bonus
		Notify:FireClient(plr, "levelup", d.level, bonus)
	end
end

CastEvent.OnServerEvent:Connect(function(plr)
	local d = sessions[plr]
	if not d or busy[plr] then return end

	local char = plr.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if not hrp or not hum or hum.Health <= 0 then return end

	local zone = getZone(hrp)
	if not zone then
		Notify:FireClient(plr, "info", "Berdiri di dermaga untuk memancing!")
		return
	end
	if d.level < zone.minLevel then
		Notify:FireClient(plr, "info", zone.label .. " butuh Level " .. zone.minLevel .. "!")
		return
	end

	local look = flat(hrp.CFrame.LookVector)
	if look.Magnitude < 0.01 then return end
	local target = hrp.Position + look.Unit * 16
	if (flat(target) - flat(zone.water)).Magnitude > zone.waterR then
		Notify:FireClient(plr, "info", "Hadap ke arah air!")
		return
	end
	target = Vector3.new(target.X, zone.water.Y + 0.3, target.Z)

	busy[plr] = true
	local rod = Data.RODS[d.rod]
	equipRod(plr)

	local waitTime = rod.speed + math.random() * 1.5
	Notify:FireClient(plr, "cast", target, waitTime)
	task.wait(waitTime)

	if not plr.Parent or not sessions[plr] then
		busy[plr] = nil
		return
	end

	local luck = rod.luck
	if d.boostUntil > os.time() then
		luck *= 2
	end

	local fish = pickFish(zone.name, luck)
	local t = math.random() ^ 1.5
	local weight = math.floor((fish.minW + (fish.maxW - fish.minW) * t) * 100) / 100
	local price = math.max(1, math.floor(fish.price * (0.7 + 0.6 * t)))
	local order = Data.RARITY_ORDER[fish.rarity]

	local inv = d.inv[fish.name]
	if not inv then
		inv = {n = 0, v = 0}
		d.inv[fish.name] = inv
	end
	inv.n += 1
	inv.v += price

	local isNew = false
	local idx = d.index[fish.name]
	if not idx then
		idx = {n = 0, maxW = 0}
		d.index[fish.name] = idx
		isNew = true
	end
	idx.n += 1
	if weight > idx.maxW then
		idx.maxW = weight
	end

	d.total += 1
	for i, q in ipairs(Data.QUESTS) do
		if q.kind == "catch"
			or (q.kind == "rare" and order >= 3)
			or (q.kind == "epic" and order >= 4)
			or (q.kind == "deep" and zone.name == "Laut") then
			d.qprog[i] += 1
		end
	end

	addXp(plr, d, Data.XP[fish.rarity])
	busy[plr] = nil

	Notify:FireClient(plr, "catch", fish.name, fish.rarity, weight, price, isNew)
	if order >= 5 then
		Notify:FireAllClients("global", plr.Name, fish.name, fish.rarity, weight)
	end
	refresh(plr)
end)

---------------------------------------------------------------- jual, beli, teleport, misi
SellEvent.OnServerEvent:Connect(function(plr)
	local d = sessions[plr]
	if not d then return end
	local total, count = 0, 0
	for _, e in pairs(d.inv) do
		total += e.v
		count += e.n
	end
	if count == 0 then
		Notify:FireClient(plr, "info", "Belum ada ikan untuk dijual!")
		return
	end
	d.inv = {}
	d.coins += total
	for i, q in ipairs(Data.QUESTS) do
		if q.kind == "earn" then
			d.qprog[i] += total
		end
	end
	Notify:FireClient(plr, "sell", total, count)
	refresh(plr)
end)

BuyRodEvent.OnServerEvent:Connect(function(plr, index)
	local d = sessions[plr]
	if not d or type(index) ~= "number" then return end
	index = math.floor(index)
	local rod = Data.RODS[index]
	if not rod or index <= d.rod then return end
	if d.coins < rod.price then
		Notify:FireClient(plr, "info", "Koin kamu kurang!")
		return
	end
	d.coins -= rod.price
	d.rod = index
	giveRod(plr)
	Notify:FireClient(plr, "info", "Kamu sekarang pakai " .. rod.name .. "!")
	refresh(plr)
end)

BuyBoostEvent.OnServerEvent:Connect(function(plr)
	local d = sessions[plr]
	if not d then return end
	if d.coins < Data.BOOST_PRICE then
		Notify:FireClient(plr, "info", "Koin kamu kurang!")
		return
	end
	d.coins -= Data.BOOST_PRICE
	d.boostUntil = math.max(os.time(), d.boostUntil) + Data.BOOST_SECONDS
	Notify:FireClient(plr, "info", "Ramuan Luck x2 aktif!")
	refresh(plr)
end)

TeleportEvent.OnServerEvent:Connect(function(plr, key)
	local d = sessions[plr]
	if not d or type(key) ~= "string" then return end
	local char = plr.Character
	if not char then return end
	for _, t in ipairs(Data.TELEPORTS) do
		if t.key == key then
			if d.level < t.minLevel then
				Notify:FireClient(plr, "info", t.name .. " butuh Level " .. t.minLevel .. "!")
				return
			end
			char:PivotTo(CFrame.new(t.pos))
			return
		end
	end
end)

ClaimEvent.OnServerEvent:Connect(function(plr, i)
	local d = sessions[plr]
	if not d or type(i) ~= "number" then return end
	local q = Data.QUESTS[i]
	if not q then return end
	if d.qprog[i] >= q.goal then
		d.qprog[i] = 0
		d.coins += q.reward
		Notify:FireClient(plr, "info", "Misi selesai! +" .. q.reward .. " koin")
		refresh(plr)
	end
end)

---------------------------------------------------------------- pemain
local function setup(plr)
	local ls = Instance.new("Folder")
	ls.Name = "leaderstats"
	for _, n in ipairs({"Koin", "Level", "Tangkapan"}) do
		local v = Instance.new("IntValue")
		v.Name = n
		v.Parent = ls
	end
	ls.Parent = plr

	plr.CharacterAdded:Connect(function()
		while plr.Parent and not sessions[plr] do
			task.wait(0.2)
		end
		task.wait(0.5)
		giveRod(plr)
	end)

	local d = loadData(plr)
	if not plr.Parent then return end
	sessions[plr] = d
	refresh(plr)
	if plr.Character then
		giveRod(plr)
	end
end

Players.PlayerAdded:Connect(setup)
for _, plr in ipairs(Players:GetPlayers()) do
	task.spawn(setup, plr)
end

Players.PlayerRemoving:Connect(function(plr)
	saveData(plr)
	sessions[plr] = nil
	busy[plr] = nil
end)

game:BindToClose(function()
	for _, plr in ipairs(Players:GetPlayers()) do
		saveData(plr)
	end
end)

task.spawn(function()
	while true do
		task.wait(60)
		for _, plr in ipairs(Players:GetPlayers()) do
			saveData(plr)
		end
	end
end)

---------------------------------------------------------------- dunia
-- siklus siang malam
task.spawn(function()
	Lighting.ClockTime = 14
	while true do
		task.wait(1)
		Lighting.ClockTime = (Lighting.ClockTime + 0.04) % 24
	end
end)

-- ProximityPrompt (buka panel di klien)
for _, inst in ipairs(Workspace:GetDescendants()) do
	if inst:IsA("ProximityPrompt") then
		inst.Triggered:Connect(function(plr)
			Notify:FireClient(plr, "open", inst.Name)
		end)
	end
end

-- papan nama melayang: part berawalan "Sign_"
for _, inst in ipairs(Workspace:GetDescendants()) do
	if inst:IsA("BasePart") and inst.Name:sub(1, 5) == "Sign_" then
		local text = inst.Name:sub(6):gsub("_", " ")
		local gui = Instance.new("BillboardGui")
		gui.Size = UDim2.new(0, 260, 0, 44)
		gui.StudsOffset = Vector3.new(0, 1, 0)
		gui.MaxDistance = 140
		gui.AlwaysOnTop = false
		gui.Parent = inst
		local lbl = Instance.new("TextLabel")
		lbl.Size = UDim2.new(1, 0, 1, 0)
		lbl.BackgroundTransparency = 1
		lbl.Text = text
		lbl.TextScaled = true
		lbl.Font = Enum.Font.GothamBold
		lbl.TextColor3 = Color3.new(1, 1, 1)
		lbl.TextStrokeTransparency = 0.3
		lbl.Parent = gui
	end
end
]]></ProtectedString></Properties></Item>
